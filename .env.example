POSTGRES_USER=infoprepaga
POSTGRES_DB=infoprepaga
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql://infoprepaga:replace-with-random-password@postgres:5432/infoprepaga?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://crm.example.com
# Optional private R2 storage; provided only to the backend container.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Server-only YCloud integration. Complete all fields before enabling.
YCLOUD_ENABLED=false
# Backend only. Main Compose forces these off; local tests require explicit override.
YCLOUD_ALLOW_NON_AD_TEST_MESSAGES=false
YCLOUD_TEST_SENDERS=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_WABA_ID=
YCLOUD_BUSINESS_PHONE_NUMBER=
YCLOUD_LEAD_SOURCE_CODE=
