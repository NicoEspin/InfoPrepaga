NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://infoprepaga:replace-with-your-local-password@localhost:5433/infoprepaga?schema=public"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
POSTGRES_USER=infoprepaga
POSTGRES_DB=infoprepaga
POSTGRES_PASSWORD=replace-with-your-local-password
# Optional: private Cloudflare R2 storage. Leave empty until configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional, only for the explicit one-time bootstrap; never committed or logged.
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Server-only YCloud integration. Complete all fields before enabling.
YCLOUD_ENABLED=false
# Backend only; comma-separated international test senders (never NEXT_PUBLIC_*).
YCLOUD_ALLOW_NON_AD_TEST_MESSAGES=false
YCLOUD_TEST_SENDERS=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_WABA_ID=
YCLOUD_BUSINESS_PHONE_NUMBER=
YCLOUD_LEAD_SOURCE_CODE=
# Server-only. One legal controller per CRM instance; see landing integration guides.
CRM_DATA_CONTROLLER_ID=
LANDING_INFOPREPAGA_ENABLED=false
LANDING_INFOPREPAGA_CONTROLLER_ID=
LANDING_INFOPREPAGA_TOKEN=
LANDING_INFOPREPAGA_PREVIOUS_TOKEN=
LANDING_INFOPREPAGA_PRIVACY_VERSION=
LANDING_COBERTURAS_MEDICAS_ENABLED=false
LANDING_COBERTURAS_MEDICAS_CONTROLLER_ID=
LANDING_COBERTURAS_MEDICAS_TOKEN=
LANDING_COBERTURAS_MEDICAS_PREVIOUS_TOKEN=
LANDING_COBERTURAS_MEDICAS_PRIVACY_VERSION=
